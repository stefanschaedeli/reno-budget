# ============================================================
# Reno-Budget — Beispiel-Umgebungskonfiguration
# Kopiere diese Datei nach `deploy/.env` und passe die Werte an.
# Niemals echte Geheimnisse einchecken!
# ============================================================

# --- Allgemein ---
RENO_ENVIRONMENT=production
RENO_LOG_LEVEL=INFO
RENO_API_PREFIX=/api/v1

# --- CORS / Proxy ---
# Komma-separierte Liste; leer = keine externen Origins erlaubt.
RENO_CORS_ALLOW_ORIGINS=
# IPs des vorgeschalteten Reverse-Proxys, denen X-Forwarded-* geglaubt wird.
RENO_TRUSTED_PROXY_IPS=

# --- Datenbank (Postgres) ---
POSTGRES_USER=reno
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reno
RENO_DATABASE_URL=postgresql+asyncpg://reno:change-me@db:5432/reno

# --- Auth / Krypto ---
# Mindestens 64 zufällige Bytes, base64 oder hex.
RENO_JWT_SECRET=change-me-with-openssl-rand-base64-64
RENO_JWT_ALGORITHM=HS256
RENO_ACCESS_TOKEN_TTL_MINUTES=15
RENO_REFRESH_TOKEN_TTL_DAYS=14

# --- Uploads ---
RENO_UPLOADS_ROOT=/data/uploads
RENO_UPLOAD_MAX_BYTES=26214400

# --- SMTP (Einladungen, Passwort-Reset, Erinnerungen) ---
RENO_SMTP_HOST=
RENO_SMTP_PORT=587
RENO_SMTP_USER=
RENO_SMTP_PASSWORD=
RENO_SMTP_FROM=reno-budget@example.ch

# --- KI-Assistent (Anthropic) ---
# Serverseitiger API-Schlüssel für den KI-Projekt-Assistenten. Leer lassen, um
# die Funktion zu deaktivieren (die Endpunkte antworten dann mit 503). Wird nie
# an den Browser ausgeliefert.
RENO_ANTHROPIC_API_KEY=

# --- Worker (nächtliche Backups + wöchentliche Erinnerungs-Digests) ---
# Zielverzeichnis für pg_dump-Backups (innerhalb des Worker-Containers).
RENO_BACKUPS_DIR=/data/backups
# Cron-Ausdruck im APScheduler-Format (Standard: nächtlich 02:30 UTC).
RENO_WORKER_BACKUP_CRON=30 2 * * *
# Wöchentlicher Versand der Digest-E-Mails (Standard: Montag 07:00 UTC).
RENO_WORKER_DIGEST_CRON=0 7 * * MON
# Aufbewahrung: Anzahl täglicher und monatlicher Backups, die behalten werden.
RENO_WORKER_BACKUP_RETENTION_DAILY=30
RENO_WORKER_BACKUP_RETENTION_MONTHLY=12
# Basis-URL der Webanwendung — wird in Erinnerungs-E-Mails verlinkt.
RENO_APP_BASE_URL=https://reno-budget.example.ch

# --- Web (nginx Reverse-Proxy auf API) ---
WEB_PORT=8080
